{
  "version": 2,
  "rewrites": [
    { "source": "/subscribe", "destination": "/api/subscribe.js" },
    { "source": "/unsubscribe", "destination": "/api/unsubscribe.js" },
    { "source": "/send-all", "destination": "/api/send-all.js" },
    { "source": "/send-one", "destination": "/api/send-one.js" },
    { "source": "/subscribers", "destination": "/api/subscribers.js" }
  ]
}
{
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
